# Supabase — Project URL и anon key из Dashboard → Settings → API
# (проект spiderman-cards-game, ref ijrfnstdmnkkbrwyeisf, схема "delivery")
# Перед первым запуском нужно один раз включить "delivery" в
# Dashboard → Settings → API → Exposed schemas — иначе PostgREST
# по умолчанию видит только public и не найдёт наши таблицы.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Аналитика (Яндекс.Метрика или аналог) — для отслеживания трафика из Telegram-чатов
NEXT_PUBLIC_ANALYTICS_ID=
